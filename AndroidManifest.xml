<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mock.banking">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Canara Bank"
        android:theme="@style/Theme.AppCompat">
        
        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- THE VULNERABILITY: Exported receiver allows external apps/system to trigger it -->
        <receiver android:name=".ZeroClickReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mock.bank.TRIGGER_TRANSFER" />
            </intent-filter>
        </receiver>

    </application>
</manifest>